# ============================================================
# BACKEND ENVIRONMENT VARIABLES — copy to .env for local dev
# Set ALL of these in Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# Django Core
SECRET_KEY=your-long-random-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=your-backend-project.vercel.app,localhost,127.0.0.1

# CORS — set to your frontend Vercel URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app,http://localhost:3000

# Database — use PostgreSQL in production (Neon, Supabase, Railway, etc.)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://your_user:your_password@your_host:5432/your_db

# Media Storage — use ImageKit (free, works globally including Zimbabwe)
USE_IMAGEKIT=True
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Cloudinary (alternative — not available in Zimbabwe)
USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email (optional — for order confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your@gmail.com

# Payments (set to your real keys in production)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
ECOCASH_MERCHANT_CODE=
ONEMONEY_MERCHANT_ID=

# Delivery fees (defaults used if not set)
DELIVERY_FEE_BASE=10.00
DELIVERY_FEE_PER_KM=0.50
